{
  "manifest_version": 3,
  "name": "OmegaWeapon",
  "short_name": "Omega",
  "version": "2.0.0",
  "description": "The Agency Radar (222 US and European digital marketing agencies read through the Horus digital-marketing edition) and every OmegaWeapon target dashboard, in one offline app.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OmegaWeapon",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "omnibox": {
    "keyword": "omega"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "sidePanel",
    "contextMenus"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open the OmegaWeapon popup"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the full OmegaWeapon app"
    },
    "open-targets": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open the Targets wing"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'self'"
  }
}
